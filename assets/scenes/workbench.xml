<mujoco model="ur5e_workbench">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" impratio="10"/>

  <statistic center="0 0 0.8" extent="1.5"/>
  <visual>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="960"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <!-- 组合模型由 scripts/build_robot.py 生成，包含腕部夹爪及其控制器。 -->
    <model name="ur5e" file="../robots/ur5e_2f85.xml"/>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.35 0.43 0.52" rgb2="0.85 0.89 0.92"
             width="512" height="3072"/>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.30 0.33 0.36" rgb2="0.35 0.38 0.41"
             width="512" height="512"/>
    <material name="floor_material" texture="floor_texture"
              texrepeat="4 4" texuniform="true" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -1 2.5" dir="0 0.4 -1"/>
    <light name="fill_light" pos="1 1 2" dir="-0.5 -0.5 -1"
           diffuse="0.4 0.4 0.4" castshadow="false"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="floor_material"/>

    <include file="../furniture/table.xml"/>

    <!-- 底座安装平面与桌面齐平；绕 Z 轴转 -90 度，使 home 姿态朝向桌面中央。 -->
    <body name="robot_mount" pos="-0.4 0 0.75" euler="0 0 -1.5707963267948966">
      <attach model="ur5e" body="base" prefix="ur5e/"/>
    </body>

    <include file="../objects/cube.xml"/>
    <include file="../objects/socket.xml"/>

    <!-- 位于机械臂前方（+X），以 45 度俯角看向抓取区域 (0.15, 0.05, 0.9)。 -->
    <camera name="scene_camera" pos="1.15 0.05 1.9"
            xyaxes="0 1 0 -1 0 1" fovy="50" resolution="640 480"/>

    <!-- 固定预览相机，覆盖桌面和机械臂。 -->
    <camera name="overview" pos="1.6 -1.6 1.8" xyaxes="1 1 0 -1 1 3" fovy="45"/>
  </worldbody>
</mujoco>
